<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The site has no push service, so notifications are polled and posted locally. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        The voice room records and plays audio through the room page running inside the
        hidden WebView (see ChatBridge), so the app itself has to hold the recording
        permission and grant it to that capture request.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
        The app ships itself: updates are a signed APK from its own releases, handed to
        Android's installer as a session (see ApkInstaller). Without this permission the
        session cannot be created at all.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Backup is off on purpose. The app keeps the delidehset.com session cookies in
        SharedPreferences, and Android auto-backup would upload them to the user's cloud
        backup and restore them on the next install — which made a freshly installed
        build come up already signed in. The rules below cover device-to-device transfer
        as well, where the allowBackup flag alone is not always honoured.
    -->
    <application
        android:name=".DeliApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Delidehset">

        <!--
            adjustNothing on purpose. With adjustResize the system shrinks the window for
            the keyboard, which drags the bottom bar up and leaves it sitting on top of the
            keyboard. The bar belongs to the screen's bottom edge, where the keyboard
            simply covers it; the app lifts the content it wants lifted (the chat
            composer) by the IME inset itself — see DeliScaffold.
        -->
        <!--
            singleTop, because a link belongs in the app that is already open: a second
            copy of the app on top of itself is what the default launch mode would give.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.Delidehset">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                The site's own links: tapping one in a browser, a message or any other app
                opens Hoset instead of the browser, and the router below turns it into the
                screen that link is about.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="delidehset.com" />
                <data android:scheme="http" android:host="delidehset.com" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".MainActivityDark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityPurple"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_purple"
            android:roundIcon="@mipmap/ic_launcher_purple"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityDeli"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark"
            android:label="@string/app_name_deli">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityDD"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_purple"
            android:roundIcon="@mipmap/ic_launcher_purple"
            android:label="@string/app_name_dd">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityCat"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cat"
            android:roundIcon="@mipmap/ic_launcher_cat"
            android:label="@string/app_name_deli">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Where the installer reports back: "confirm", "installed" or why not. -->
        <receiver
            android:name=".data.InstallResultReceiver"
            android:exported="false" />

        <!-- The notification poll, and the alarm that starts it again after a reboot. -->
        <receiver
            android:name=".notify.NotificationPollReceiver"
            android:exported="false" />

        <receiver
            android:name=".notify.NotificationBootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
